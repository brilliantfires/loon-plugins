#!name=开屏广告
#!desc=仅处理明确开屏入口；不保证覆盖所有 App 的所有开屏。无 JS、无定时任务、无外部资源。关闭开关不移除静态 MitM 域名；不用时停用整个插件。
#!author=原规则：可莉、RuCu6、fmz200、zmqcherish、Sliverkiss、kokoryh、Keywos、app2smile；精简整理：Codex
#!homepage=https://github.com/brilliantfires/loon-plugins
#!tag=去广告
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(998)
#!date=2026-11-06

[Argument]
app_12306 = switch,true,tag=12306
app_Amap = switch,true,tag=高德地图
app_Bilibili = switch,true,tag=哔哩哔哩
app_Coolapk = switch,true,tag=酷安
app_Douban = switch,false,tag=豆瓣,desc=沿用原插件限制仅适用兼容的签名版豆瓣
app_Goofish = switch,true,tag=闲鱼
app_JD = switch,true,tag=京东
app_McDonalds = switch,true,tag=麦当劳
app_Taobao = switch,true,tag=淘宝
app_Tieba = switch,true,tag=百度贴吧
app_Weibo = switch,true,tag=微博
app_Xiaohongshu = switch,true,tag=小红书
app_Xiaoxiang = switch,true,tag=小象超市
app_Zhihu = switch,true,tag=知乎
app_Zhuanzhuan = switch,true,tag=转转

[Rewrite]

# 12306
# 仅开屏广告接口
request if ${app_12306} == true && ${url} ~= /^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList(?:\?|$)/i then reject_dict(200)

# 高德地图
# 开屏：路径含 splash 的接口统一返回空 JSON，兼容无 query 与 _v2 变体
request if ${app_Amap} == true && ${url} ~= /^https:\/\/m5\.amap\.com\/[^?]*\/splash[a-z0-9_\/-]*(\?|$)/i then reject_dict(200)
# 清除启动配置内所有 splash 开头的字段，覆盖后续版本新增的开屏开关
response if ${app_Amap} == true && ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1(?:\?|$)/i then response.json.jq(`if type=="object" then . as $original | try (if (.data|type)=="object" then .data |= with_entries(select((.key|test("^[Ss]plash"))|not)) else . end) catch $original else . end`)

# 哔哩哔哩
# 保留原开屏列表清理
response if ${app_Bilibili} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\?/i then response.json.jq(`if type=="object" then . as $original | try (if (.data | type) == "object" then .data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end) else . end) catch $original else . end`)
# 保留原开屏模拟响应；不处理视频播放
response if ${app_Bilibili} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?/i then response.body.mock("json", `{"code":0,"message":"OK","ttl":1,"data":{"max_time":0,"min_interval":31536000,"pull_interval":31536000,"keep_ids":[],"show":[],"list":[{}],"splash_request_id":""}}`, 200)

# 酷安
# 保留所有初始化卡片；仅修改旧版已有开屏字段和等待参数；新组合待实测
response if ${app_Coolapk} == true && ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/main\/init(?:\?|$)/i then response.json.jq(`if type=="object" then . as $original | try (if (.data|type)=="array" then .data |= map(if type=="object" and (.extraDataArr|type)=="object" then .extraDataArr |= (if has("SplashAd.Type") then .["SplashAd.Type"]="" | .["SplashAd.resumeType"]="" | .["SplashAd.hType"]="" | .["SplashAd.onResume"]=0 | if has("SplashAd.timeout") then .["SplashAd.timeout"]="1" else . end else . end) else . end) else . end) catch $original else . end`)

# 豆瓣
# 仅开屏广告接口；沿用原插件签名版限制
request if ${app_Douban} == true && ${url} ~= /^https:\/\/api\.douban\.com\/v\d\/app_ads\/splash/i then reject_dict(200)
# 保留三个开屏 SDK 配置字段处理
response if ${app_Douban} == true && ${url} ~= /^https:\/\/frodo\.douban\.com\/api\/v2\/feature_switch(?:\?|$)/i then response.json.jq(`if type=="object" then . as $original | try (.splash_sdk_info=[] | .enable_splash_client_bid=false | .splash_client_bid_use_preload=false) catch $original else . end`)

# 闲鱼
# 仅明确开屏接口；排除 scene.restore 全场景拦截
request if ${app_Goofish} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads\//i then reject_dict(200)

# 京东
# 仅 start 开屏图片和展示次数
response if ${app_JD} == true && ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:start)(?:&|$)/i then response.json.jq(`if type=="object" then . as $original | try (if has("images") then .images=[] else . end | if has("showTimesDaily") then .showTimesDaily=0 else . end) catch $original else . end`)

# 麦当劳
# 沿用开屏投放过期方案
response if ${app_McDonalds} == true && ${url} ~= /^https:\/\/api\.mcd\.cn\/bff\/portal\/home\/splash(?:\?|$)/i then response.json.jq(`if type=="object" then . as $original | try (if (.data.list | type) == "array" then .data.list |= map(.countDown=0 | .beginTime="2000-01-01 00:00:00" | .endTime="2000-01-01 00:00:00" | if (.showTimeList | type) == "array" then .showTimeList |= map(.beginDate="2000-01-01" | .endDate="2000-01-01") else . end) else . end) catch $original else . end`)

# 淘宝
# 从原 JS 迁移开屏配置分支；不拦截普通视频或通用活动模板
response if ${app_Taobao} == true && ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:\/|\?|$)/i then response.json.jq(`if type=="object" then . as $original | try (if (.data.containers.splash_home_base.base.sections|type)=="array" then (.data.containers.splash_home_base.base.sections[] | select(type=="object") | .bizData["taobao-splash"].data | select(type=="array")) |= map(if type=="object" then . + {waitTime:"0",times:"0",hotStart:"false",haveVoice:"false",hideTBLogo:"false",enable4G:"false",coldStart:"false",startTime:"3818332800000",endTime:"3818419199000",gmtStart:"2090-12-31 00:00:00",gmtEnd:"2090-12-31 23:59:59",gmtStartMs:"3818332800000",gmtEndMs:"3818419199000"} | (if .imgUrl then .imgUrl="" else . end) | (if .videoUrl then .videoUrl="" else . end) else . end) else . end) catch $original else . end`)

# 百度贴吧
# 仅已知 home_screen_ad 字段；不保证覆盖其他 SDK 开屏
response if ${app_Tieba} == true && ${url} ~= /^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync(?:\?|$)/i then response.json.jq(`if type=="object" then . as $original | try (del(.home_screen_ad)) catch $original else . end`)

# 微博
# 迁移原开屏预加载分支
response if ${app_Weibo} == true && ${url} ~= /^https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload(?:\?|$)/i then response.json.jq(`if type=="object" then . as $original | try (if (.ads|type)=="array" then .ads |= map(if type=="object" then .start_time=3818332800 | .end_time=3818419199 | .daily_display_cnt=50 | .display_duration=0 else . end) else . end) catch $original else . end`)
# 迁移原开屏缓存分支
response if ${app_Weibo} == true && ${url} ~= /^https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua)(?:\?|$)/i then response.json.jq(`if type=="object" then . as $original | try (if (.cached_ad.ads|type)=="array" then .cached_ad.ads |= map(if type=="object" then .show_count=50 | .duration=0 | .start_date=3818332800 | .end_date=3818419199 else . end) else . end) catch $original else . end`)
# 定点替换已知开屏标量字段；兼容 JSON+OK；不对广告数组做正则删除
response if ${app_Weibo} == true && ${url} ~= /^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php(?:\?|$)/i then response.body.replace(/"show_push_splash_ad"\s*:\s*true/, `"show_push_splash_ad":false`) | response.body.replace(/"background_delay_display_time"\s*:\s*\d+/, `"background_delay_display_time":31536000`) | response.body.replace(/"lastAdShow_delay_display_time"\s*:\s*\d+/, `"lastAdShow_delay_display_time":31536000`) | response.body.replace(/"realtime_ad_video_stall_time"\s*:\s*\d+/, `"realtime_ad_video_stall_time":0`) | response.body.replace(/"realtime_ad_timeout_duration"\s*:\s*\d+/, `"realtime_ad_timeout_duration":0`) | response.body.replace(/"displaytime"\s*:\s*\d+/, `"displaytime":0`) | response.body.replace(/"displayintervel"\s*:\s*\d+/, `"displayintervel":31536000`) | response.body.replace(/"allowdaydisplaynum"\s*:\s*\d+/, `"allowdaydisplaynum":0`)

# 小红书
# 不删除商店、主题和加载图片等非广告配置
response if ${app_Xiaohongshu} == true && ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/config(?:\?|$)/ then response.json.jq(`if type=="object" then . as $original | try (del(.data.splash)) catch $original else . end`)
# 沿用原开屏投放时间处理，无媒体缓存
response if ${app_Xiaohongshu} == true && ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/system_service\/splash_config(?:\?|$)/ then response.json.jq(`if type=="object" then . as $original | try (if (.data.ads_groups|type)=="array" then .data.ads_groups |= map(if type=="object" then .start_time=3818332800 | .end_time=3818419199 | if (.ads|type)=="array" then .ads |= map(if type=="object" then .start_time=3818332800 | .end_time=3818419199 else . end) else . end else . end) else . end) catch $original else . end`)

# 小象超市
# 仅开屏广告接口
request if ${app_Xiaoxiang} == true && ${url} ~= /^https:\/\/mall\.meituan\.com\/api\/c\/homepage\/splash/i then reject_dict(200)

# 知乎
# 只清空 launch.ads，保留其他浮层和原字符串格式
response if ${app_Zhihu} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/commercial_api\/(?:real_time_launch_v2|launch_v2)(?:\?|$)/ then response.json.jq(`if type=="object" then . as $original | try (if (.launch|type)=="string" then .launch |= (. as $original | try (fromjson | .ads=[] | tojson) catch $original) elif (.launch|type)=="object" then .launch.ads=[] else . end) catch $original else . end`)

# 转转
# 仅开屏接口
request if ${app_Zhuanzhuan} == true && ${url} ~= /^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/getOpenScreen(?:\?|$)/i then reject_dict(200)

[MitM]
# 静态名单。开关仅关闭复写，不动态撤销 TLS 解密。
hostname = acs.m.goofish.com, ad.12306.cn, api.coolapk.com, api.douban.com, api.m.jd.com, api.mcd.cn, api.zhihu.com, app.bilibili.com, app.zhuanzhuan.com, bootpreload.uve.weibo.com, edith.xiaohongshu.com, frodo.douban.com, guide-acs.m.taobao.com, m5.amap.com, mall.meituan.com, sdkapp.uve.weibo.com, tiebac.baidu.com, wbapp.uve.weibo.com
