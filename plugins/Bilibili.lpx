#!name=哔哩哔哩
#!desc=默认仅清理明确广告。评论、动态、视频页扩展、互动弹幕、空降助手、播放增强等高风险功能均由独立开关控制并默认关闭。
#!homepage=https://github.com/kokoryh/Sparkle
#!tag=去广告
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(998)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png
#!openUrl=https://apps.apple.com/app/id736536022
#!author=原脚本：kokoryh；完整开关封装：Codex
#!date=2026-11-04

[Argument]
splashAds = switch,true,tag=开屏与启动广告
feedAds = switch,true,tag=推荐流显式广告
searchAds = switch,true,tag=搜索结果显式广告
liveAds = switch,true,tag=直播广告与购物浮层
exactAds = switch,true,tag=明确广告素材接口
feedVideoOnly = switch,false,tag=首页只保留视频卡片,desc=非广告功能。开启时会移除首页的非视频卡片。
feedCardExtraClean = switch,false,tag=推荐流卡片附加广告字段,desc=额外移除故事卡的购物图标、课程、游戏等字段。
searchClean = switch,false,tag=搜索热词精简,desc=移除默认搜索词和搜索广场资源。
commentAds = switch,false,tag=评论处理总开关,desc=会改写评论响应，可能影响置顶操作卡片。推广文字过滤须同时打开总开关。
purifyComment = switch,false,tag=过滤评论推广文字,desc=必须在评论处理总开关开启后生效；使用关键词识别，可能误判正常评论。
dynamicAds = switch,false,tag=动态页处理总开关,desc=会同时移除广告、直播推荐和话题卡片，并应用下方的最常访问设置。
displayUpList = select,"show","auto","hide",tag=最常访问显示方式
videoPageAds = switch,false,tag=视频页扩展广告,desc=会精简相关推荐、活动栏、付费栏和部分功能模块。
uiClean = switch,false,tag=页面与标签精简,desc=精简顶部资源、皮肤、影视页和底部标签。
endingPageAds = switch,false,tag=播放结束页与暂停页素材,desc=会清空结束页、暂停页和互动素材响应，可能影响相关操作入口。
accountClean = switch,false,tag=账号页整理,desc=会重排“我的”页面服务区，可能隐藏部分官方入口。
accountVipAppearance = switch,false,tag=会员状态本地显示,desc=仅改变客户端显示，不会获得真实会员权益；默认关闭。
optimizeRequest = switch,false,tag=请求重取优化,desc=会重新获取视频页和评论请求，可能影响加载速度或评论内容。
interactiveDanmakuClean = switch,false,tag=互动弹幕命令清理,desc=仅处理 DmView 的 commandDms，会删除投票、购物等互动弹幕。
sponsorBlock = switch,false,tag=空降助手,desc=会读取第三方分段，并改写弹幕请求和播放进度响应。
playbackEnhance = switch,false,tag=播放能力增强,desc=会改写播放地址响应，解锁后台播放和投屏相关能力。
disableTeenMode = switch,false,tag=关闭青少年提示
p2pClean = switch,false,tag=P2P节点改写,desc=仅改写 tracker 配置，不使用域名级硬拒绝。
legacyDomainBlock = switch,false,tag=旧域名请求拦截,desc=拦截 api/app.biliapi.com 与 api/app.biliapi.net 的 HTTPS 请求，可能误伤正常功能。
webpageClean = switch,false,tag=哔哩哔哩网页活动页清理
logLevel = select,"off","error","warn","info","debug",tag=日志等级

[Rewrite]
request if ${splashAds} == true && ${url} ~= /^https:\/\/(?:api\.bilibili\.com\/x\/mengqi\/v1\/resource|app\.bilibili\.com\/x\/resource\/peak\/download)(?:\?|$)/i then reject_dict(200)

request if ${liveAds} == true && ${url} ~= /^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\?/i then reject_dict(200)
request if ${liveAds} == true && ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\?/i then reject_dict(200)
response if ${liveAds} == true && ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/index\/feed\?/i then response.json.jq(`if (.data.card_list | type) == "array" then .data.card_list |= map(select(.card_type != "banner_v2" and .card_type != "activity_card_v1")) else . end`)
response if ${liveAds} == true && ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoBy(Room|User)\?/i then response.json.jq(`del(.data.shopping_info, .data.activity_banner_info)`)

response if ${splashAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\?/i then response.json.jq(`if (.data | type) == "object" then .data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end) else . end`)
response if ${splashAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?/i then response.body.mock("json", `{"code":0,"message":"OK","ttl":1,"data":{"max_time":0,"min_interval":31536000,"pull_interval":31536000,"keep_ids":[],"show":[],"list":[{}],"splash_request_id":""}}`, 200)

response if ${feedAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?/i then response.json.jq(`if (.data.items | type) == "array" then .data.items |= map(select(.ad_info == null)) else . end`)
response if ${feedAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\?/i then response.json.jq(`if (.data.items | type) == "array" then .data.items |= map(select(.ad_info == null and (.card_goto | IN("vertical_ad_av", "vertical_ad_live", "vertical_ad_picture") | not))) else . end`)
response if ${feedVideoOnly} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?/i then response.json.jq(`if (.data.items | type) == "array" then .data.items |= map(select(.banner_item == null and .ad_info == null and .card_goto == "av" and (.card_type | IN("small_cover_v2", "large_cover_single_v9", "large_cover_v1")))) else . end`)
response if ${feedCardExtraClean} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\?/i then response.json.jq(`if (.data.items | type) == "array" then .data.items |= map(del(.story_cart_icon, .free_flow_toast, .image_infos, .course_info, .game_info)) else . end`)

response if ${exactAds} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/vip\/ads\/materials\?/i then response.body.mock("json", `{"code":-404,"message":"-404","ttl":1,"data":null}`, 200)
response if ${exactAds} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?/i then response.body.mock("json", `{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}`, 200)

response if ${searchClean} == true && ${url} == "https://grpc.biliapi.net/bilibili.app.interface.v1.Search/DefaultWords" then response.body.mock("text", "AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=", 200, true) | response.header.set("grpc-status", "0")
response if ${searchClean} == true && ${url} ~= /^https:\/\/ap[ip]\.bilibili\.com\/x\/v2\/search\/square\?/i then response.body.mock("json", `{"code":-404,"message":"-404","ttl":1,"data":null}`, 200)

response if ${uiClean} == true && ${url} ~= /^https:\/\/ap[ip]\.bilibili\.com\/x\/resource\/(top\/activity|patch\/tab(\/v2)?)\?/i then response.body.mock("json", `{"code":-404,"message":"-404","ttl":1,"data":null}`, 200)
response if ${uiClean} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?/i then response.json.jq(`del(.data.common_equip)`)
response if ${uiClean} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?/i then response.json.jq_file("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.tab.jq")
response if ${uiClean} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\?/i then response.json.jq(`del(.data.payment)`)
response if ${uiClean} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\?/i then response.json.jq(`if (.data.modules | type) == "array" then .data.modules |= map(select(.type != "TIP") | if .type == "BANNER" and (.module_data.items | type) == "array" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end) else . end`)

response if ${endingPageAds} == true && ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$/i then response.body.mock("text", "AAAAAAA=", 200, true) | response.header.set("grpc-status", "0")
response if ${accountClean} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine(\/ipad)?\?/i then response.json.jq_file("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.mine.jq")
response if ${accountVipAppearance} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?/i then response.json.jq(`.data.vip |= if . != null and .status == 0 then . + { status: 1, type: 2, due_date: 9005270400000, role: 15 } else . end`)

response if ${p2pClean} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\?/i then response.json.jq(`.data[][]?="stun.chat.bilibili.com:3478"`)
response if ${p2pClean} == true && ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\?/i then response.json.jq(`.data.domains=["wss://tracker.chat.bilibili.com"]`)

response if ${disableTeenMode} == true && ${url} == "https://grpc.biliapi.net/bilibili.app.interface.v1.Teenagers/ModeStatus" then response.body.mock("text", "AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA", 200, true) | response.header.set("grpc-status", "0")

request if ${legacyDomainBlock} == true && ${url} ~= /^https:\/\/api\.biliapi\.(?:com|net)(?:\/|$)/i then reject_dict(200)
request if ${legacyDomainBlock} == true && ${url} ~= /^https:\/\/app\.biliapi\.(?:com|net)(?:\/|$)/i then reject_dict(200)

[Script]
response if ${searchAds} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.response.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="搜索显式广告", requires_body=true, binary_body_mode=true, timeout=10

response if ${commentAds} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList$/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.response.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="评论广告与推广评论", requires_body=true, binary_body_mode=true, timeout=10

response if ${dynamicAds} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll)$/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.response.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="动态页广告与最常访问", requires_body=true, binary_body_mode=true, timeout=10

response if ${videoPageAds} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.view(unite)?\.v1\.View\/(View|RelatesFeed|AIRelateAsync)$/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.response.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="视频页扩展广告", requires_body=true, binary_body_mode=true, timeout=10

response if ${interactiveDanmakuClean} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmView$/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.response.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="互动弹幕命令清理", requires_body=true, binary_body_mode=true, timeout=10

request if ${sponsorBlock} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(community\.service\.dm\.v1\.DM\/DmSegMobile|app\.view(unite)?\.v1\.View\/ViewProgress)$/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.upstream-request.js", {${logLevel}}) with tag="空降助手请求", requires_body=true, binary_body_mode=true, timeout=10
response if ${sponsorBlock} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.view(unite)?\.v1\.View\/ViewProgress$/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.response.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="空降助手进度", requires_body=true, binary_body_mode=true, timeout=10

request if ${optimizeRequest} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.upstream-request.js", {${purifyComment}, ${logLevel}}) with tag="请求重取优化", requires_body=true, binary_body_mode=true, timeout=10

response if ${playbackEnhance} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(app\.(playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.response.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="播放能力增强", requires_body=true, binary_body_mode=true, timeout=10

response if ${webpageClean} == true && ${url} ~= /^https:\/\/www\.bilibili\.com\/blackboard\/era\/.+\.html\?/i then script("https://raw.githubusercontent.com/brilliantfires/loon-plugins/main/scripts/Bilibili.webpage.js") with tag="网页活动页清理", requires_body=true, timeout=10

[MitM]
hostname = grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, line3-h5-mobile-api.biligame.com, www.bilibili.com, api.biliapi.com, app.biliapi.com, api.biliapi.net, app.biliapi.net
