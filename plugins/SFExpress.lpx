#!name=顺丰速运
#!desc=过滤广告接口、积分商城推荐和首页指定推广模块。
#!homepage=https://hub.kelee.one
#!tag=去广告
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(998)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SF-Express.png
#!author=原规则：可莉；本地整理：Codex
#!date=2026-11-04

[Rewrite]
request if ${url} ~= /^https:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/ad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/ucmp\.sf-express\.com\/proxy\/esgcempcore\/memberGoods\/pointMallService\/goodsList$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/appHomeConfig\/query$/i then response.json.jq("if type == \"object\" then if (.obj | type) == \"array\" then .obj |= map(if type == \"object\" then select(.position != 2) else . end) else . end else . end")

[MitM]
hostname = ccsp-egmas.sf-express.com, ucmp.sf-express.com
