#!name=豆瓣
#!desc=移除开屏、信息流、首页横幅和搜索填充词，并关闭开屏 SDK 的三个开关字段。仅适用于 IPA 签名版豆瓣。
#!homepage=https://getupnote.com/share/notes/zSn1ShBmzNYISKcTgjXE5oHMrNf2/34bf3aad-7872-497d-b239-198e27e8c84c
#!tag=去广告
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(998)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DouBan.png
#!author=原规则：可莉；本地整合：Codex
#!date=2026-11-04

[Rewrite]
request if ${url} ~= /^https:\/\/api\.douban\.com\/v\d\/app_ads\/splash/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m\.douban\.com\/rexxar\/api\/v\d\/market\/products\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/frodo\.douban\.com\/api\/v\d\/movie\/ad/i then reject_dict(200)
request if ${url} ~= /^https:\/\/frodo\.douban\.com\/api\/v\d\/home_banner/i then reject_dict(200)

response if ${url} ~= /^https:\/\/frodo\.douban\.com\/api\/v2\/feature_switch(?:\?|$)/i then response.json.jq(".splash_sdk_info=[] | .enable_splash_client_bid=false | .splash_client_bid_use_preload=false")

[MitM]
hostname = api.douban.com, frodo.douban.com, m.douban.com
