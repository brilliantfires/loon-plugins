#!name=得物
#!desc=移除开屏、弹窗、搜索词、热搜、推荐信息流，并精简消息与“我的”页面。
#!homepage=https://hub.kelee.one
#!tag=去广告
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(998)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Dewu.png
#!author=原规则：可莉；本地整理：Codex
#!date=2026-11-04

[Rewrite]
request if ${url} ~= /^https:\/\/app\.dewu\.com\/api\/v1\/app\/advertisement\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/app\.dewu\.com\/api\/v1\/app\/search\/lexicon\/v3\/background_words\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/app\.dewu\.com\/api\/v1\/app\/search\/lexicon\/v1\/rank_words\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/app\.dewu\.com\/api\/v1\/app\/biz-aggregate\/me\/user-index\?/i then response.json.jq(".data.modules |= map(if .key == \"wallet\" then .data.menus |= map(select(.key == \"coupon\" or .key == \"allowance\" or .key == \"gift\" or .key == \"balance\")) else . end) | .data.modules |= map(select(.key != \"merchant\" and .key != \"discountCoupon\"))")
response if ${url} ~= /^https:\/\/app\.dewu\.com\/api\/v1\/app\/account\/wallet\/page\/entrance\?/i then response.json.jq(".data.groupInfoDTOS |= map(.moduleInfoDTO = {assetModule: .moduleInfoDTO.assetModule}) | .data.moduleNames = [.data.moduleNames[] | select(. == \"assetModule\")] | . as $full | $full | .data.groupNames |= (map(select(. == \"MAIN\" or . == \"ASYNC_COMMON\" or . == \"ASYNC_GOODS_FEEDS\")))")
response if ${url} ~= /^https:\/\/app\.dewu\.com\/identify-discovery\/v1\/discovery\/index\?/i then response.json.jq(".data.groups |= map(.items |= map(select(.title == \"消息中心\")))")
request if ${url} ~= /^https:\/\/app\.dewu\.com\/sns-rec\/v1\/attention\/feed\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/app\.dewu\.com\/sns-rec\/v1\/search\/word-skip\/new-list\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/app\.dewu\.com\/sns-rec\/v1\/search\/hotword-list\?/i then reject_dict(200)

[MitM]
hostname = app.dewu.com
