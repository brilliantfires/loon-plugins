#!name=京东
#!desc=过滤开屏、首页、个人页、订单与物流页面推广，并处理京东页面配置。
#!homepage=https://hub.kelee.one
#!tag=去广告
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(998)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
#!author=原脚本：RuCu6；本地整合：Codex
#!date=2026-11-04

[Rule]
URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:searchBoxWord|stationPullService|uniformRecommend[06])(?:&|$)/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:deliverLayer|orderTrackBusiness)(?:&|$)/i then response.json.jq("del(.bannerInfo) | if (.floors|type)==\"array\" then .floors |= map(select(.mId != \"banner\" and .mId != \"jdDeliveryBanner\")) else . end")

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:getTabHomeInfo)(?:&|$)/i then response.json.jq("del(.result.iconInfo, .result.roofTop)")

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:myOrderInfo)(?:&|$)/i then response.json.jq("if (.floors|type)==\"array\" then .floors |= map(select(.mId != \"bannerFloor\" and .mId != \"bpDynamicFloor\" and .mId != \"plusFloor\") | if .mId == \"virtualServiceCenter\" and (.data.virtualServiceCenters|type)==\"array\" then .data.virtualServiceCenters |= map(if (.serviceList|type)==\"array\" then .serviceList |= map(select(.serviceTitle != \"精选特惠\")) else . end) elif .mId == \"customerServiceFloor\" and .data.moreText then del(.data.moreIcon, .data.moreIcon_dark) | .data.moreText=\" \" else . end) else . end")

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:personinfoBusiness)(?:&|$)/i then response.json.jq("[\"applezhushou\",\"lingjindouxin\",\"dongdongnongchangxin\",\"chongwangwang\",\"kehufuwu\",\"xianzhiguanjia\",\"wenyisheng\",\"jijianfuwu\",\"zhuanzuanhongbao\",\"huanletaojin\"] as $sort | if (.floors|type)==\"array\" then .floors |= map(.mId as $id | select([\"bigSaleFloor\",\"buyOften\",\"newAttentionCard\",\"newBigSaleFloor\",\"newStyleAttentionCard\",\"newsFloor\",\"noticeFloor\",\"recommendfloor\"] | index($id) | not) | if .mId == \"basefloorinfo\" then del(.data.commonPopup,.data.commonPopup_dynamic,.data.floatLayer) | (if (.data.commonTips|type)==\"array\" then .data.commonTips=[] else . end) | (if (.data.commonWindows|type)==\"array\" then .data.commonWindows=[] else . end) elif .mId == \"iconToolFloor\" and (.data.nodes|type)==\"array\" then .data.nodes |= (to_entries | map(if .key < 2 and (.value|type)==\"array\" then .value |= (map(.functionId as $fid | select($sort | index($fid))) | sort_by(.functionId as $fid | $sort | index($fid))) else . end) | map(.value)) elif .mId == \"orderIdFloor\" and (.data.commentRemindInfo.infos|type)==\"array\" then .data.commentRemindInfo.infos=[] elif .mId == \"userinfo\" then del(.data.newPlusBlackCard) else . end) else . end")

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:start)(?:&|$)/i then response.json.jq("if has(\"images\") then .images=[] else . end | if has(\"showTimesDaily\") then .showTimesDaily=0 else . end")

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:welcomeHome)(?:&|$)/i then response.json.jq("(if (.floorList|type)==\"array\" then .floorList |= map(.type as $t | select([\"bottomXview\",\"float\",\"photoCeiling\",\"ruleFloat\",\"searchIcon\",\"topRotate\",\"tabBarAtmosphere\"] | index($t) | not)) else . end) | if (.webViewFloorList|type)==\"array\" then .webViewFloorList=[] else . end")

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:basicConfig)(?:&|$)/i then response.json.jq(".data.JDMessage.socketmonitor.isSocketEstablishedAhead=0 | .data.JDMessage.socketmonitor.isSocketReport=0 | .data.JDHttpToolKit.httpdns.httpdns=0")

[MitM]
hostname = api.m.jd.com
