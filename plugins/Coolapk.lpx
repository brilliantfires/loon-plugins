#!name=酷安
#!desc=过滤开屏、信息流、评论与热词推广，并缩短开屏等待时间；当前仍属待实机验证版本。
#!homepage=https://hub.kelee.one
#!tag=去广告
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(998)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CoolApk.png
#!author=原规则：RuCu6、可莉；本地修改：Codex
#!date=2026-11-04

[Rewrite]
request if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/feed\/detail\?/i then response.json.jq(".data.hotReplyRows |= if . then map(select(.id?)) else . end | .data.topReplyRows |= if . then map(select(.id?)) else . end | reduce (\"detailSponsorCard\", \"include_goods\", \"include_goods_ids\") as $key (.; .data[$key]=[])")
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/feed\/replyList/i then response.json.jq("if .data? and ((.data | type) == \"array\") and (.data | length > 0) then .data |= map(select(.id?)) else . end")
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/main\/dataList/i then response.json.jq(".data |= (if (type==\"array\" and length>0) then map(select((.entityTemplate!=\"sponsorCard\") and (.title!=\"精选配件\"))) else . end)")
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/page\/dataList/i then response.json.jq("if (.data | length > 0) then .data |= map(select((.title? != \"酷安热搜\") and (.entityTemplate? != \"imageScaleCard\") and (.entityTemplate? != \"sponsorCard\"))) else . end")
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/main\/indexV8/i then response.json.jq(".data |= (if length > 0 then map(.entityId as $id | select((.entityTemplate != \"sponsorCard\") and ([8639,29349,33006,32557] | index($id) | not) and ((.title // \"\" | test(\"值得买|红包\")) | not))) else . end)")
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/main\/init(?:\?|$)/i then response.json.jq(".data |= map(.entityId as $id | select([944,945] | index($id) | not) | if .entityId == 20131 and (.entities | type) == \"array\" then .entities |= map(select(.title != \"酷品\")) else . end | if (.extraDataArr | type) == \"object\" then .extraDataArr |= (if has(\"SplashAd.Type\") then .[\"SplashAd.Type\"]=\"\" | .[\"SplashAd.resumeType\"]=\"\" | .[\"SplashAd.hType\"]=\"\" | .[\"SplashAd.onResume\"]=0 | if has(\"SplashAd.timeout\") then .[\"SplashAd.timeout\"]=\"1\" else . end else . end) else . end)")

[MitM]
hostname = api.coolapk.com
