#!name=网易云音乐
#!loon_version=3.5.1(998)
#!desc=依据用户提供的规则及Keywos脚本本地维护。保留原生过滤，提供首页与底栏等17项开关。二进制响应由本地脚本处理。待实机验证。
#!author=原规则与脚本：RuCu6、Keywos；本地整理：Codex

[Argument]
homeClean = switch,true,tag=首页精简,desc=按原脚本模块白名单清理推荐页并过滤旧版首页活动广告
MY = switch,false,tag=隐藏漫游,desc=隐藏底栏漫游标签
DT = switch,false,tag=隐藏笔记,desc=隐藏底栏笔记标签
FX = switch,false,tag=隐藏发现,desc=隐藏底栏发现标签
PRGG = switch,true,tag=隐藏问候语,desc=隐藏新版首页问候语模块
PRRK = switch,false,tag=隐藏排行榜,desc=隐藏新版首页排行榜模块
PRDRD = switch,false,tag=隐藏每日推荐,desc=隐藏新版首页每日推荐模块
PRSCVPT = switch,false,tag=隐藏推荐歌单,desc=隐藏新版首页云村推荐歌单模块
PRST = switch,false,tag=隐藏快捷入口,desc=隐藏新版首页快捷入口模块
PRRR = switch,false,tag=隐藏雷达歌单,desc=隐藏新版首页雷达模块
HMPR = switch,false,tag=隐藏音乐合伙人,desc=隐藏新版首页音乐合伙人模块
PRMST = switch,false,tag=隐藏我的歌单,desc=隐藏新版首页我的歌单模块
PRCN = switch,false,tag=隐藏组合推荐,desc=隐藏新版首页组合推荐模块
commentsClean = switch,true,tag=评论区精简,desc=清理推广提示头像挂件和评论标签
discoveryClean = switch,true,tag=发现页精简,desc=移除发现页横幅
myPageClean = switch,true,tag=我的页面精简,desc=移除MyPageBar推广位
showUnfollowed = switch,false,tag=未互关提示,desc=沿用原脚本将互关天数为null的记录标为未关注你

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT
DOMAIN,ipv4.music.163.com,REJECT
DOMAIN,ipv6.music.163.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/e?api\/(ocpc\/)?ad\//i then response.body.mock("text", "")
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:delivery\/(batch-)?deliver|moment\/tab\/info\/|side-bar\/mini-program\/music-service\/account|yunbei\/account\/entrance\/)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:community\/friends\/fans-group\/artist\/group\/|mine\/applet\/redpoint|music\/songshare\/text\/recommend\/|resniche\/position\/play\/new\/|resniche\/tspopup\/show|resource\/comments?\/musiciansaid\/|user\/sub\/artist)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:ios\/version|mlivestream\/entrance\/playpage\/|link\/position\/show\/strategy|link\/scene\/show\/resource|v1\/content\/exposure\/comment\/banner\/)/i then reject_dict(200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/w?e?api\/search\/default/i then response.body.mock("text", "")
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/w?eapi\/(?:activity\/bonus\/playpage\/time\/query|resource-exposure\/|search\/(?:chart\/|rcmd\/keyword\/|specialkeyword\/))/i then reject_dict(200)
request if ${url} ~= /^https:\/\/interface\d\.music\.163\.com\/eapi\/my\/podcast\/tab\/recommend/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:batch|v2\/resource\/comment\/floor\/get)(?:\?|$)/i then script("http://192.168.3.35:18765/NeteaseCloudMusic.js", {${homeClean}, ${MY}, ${DT}, ${FX}, ${PRGG}, ${PRRK}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${PRRR}, ${HMPR}, ${PRMST}, ${PRCN}, ${commentsClean}, ${discoveryClean}, ${myPageClean}, ${showUnfollowed}}) with tag="评论区精简", requires_body=true, binary_body_mode=true, timeout=10
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:homepage\/block\/page|link\/page\/rcmd\/(?:block\/resource\/multi\/refresh|resource\/show))(?:\?|$)/i then script("http://192.168.3.35:18765/NeteaseCloudMusic.js", {${homeClean}, ${MY}, ${DT}, ${FX}, ${PRGG}, ${PRRK}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${PRRR}, ${HMPR}, ${PRMST}, ${PRCN}, ${commentsClean}, ${discoveryClean}, ${myPageClean}, ${showUnfollowed}}) with tag="首页精简", requires_body=true, binary_body_mode=true, timeout=10
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/link\/page\/discovery\/resource\/show(?:\?|$)/i then script("http://192.168.3.35:18765/NeteaseCloudMusic.js", {${homeClean}, ${MY}, ${DT}, ${FX}, ${PRGG}, ${PRRK}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${PRRR}, ${HMPR}, ${PRMST}, ${PRCN}, ${commentsClean}, ${discoveryClean}, ${myPageClean}, ${showUnfollowed}}) with tag="发现页精简", requires_body=true, binary_body_mode=true, timeout=10
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/link\/position\/show\/resource(?:\?|$)/i then script("http://192.168.3.35:18765/NeteaseCloudMusic.js", {${homeClean}, ${MY}, ${DT}, ${FX}, ${PRGG}, ${PRRK}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${PRRR}, ${HMPR}, ${PRMST}, ${PRCN}, ${commentsClean}, ${discoveryClean}, ${myPageClean}, ${showUnfollowed}}) with tag="我的页面精简", requires_body=true, binary_body_mode=true, timeout=10
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/user\/follow\/users\/mixed\/get\/v2(?:\?|$)/i then script("http://192.168.3.35:18765/NeteaseCloudMusic.js", {${homeClean}, ${MY}, ${DT}, ${FX}, ${PRGG}, ${PRRK}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${PRRR}, ${HMPR}, ${PRMST}, ${PRCN}, ${commentsClean}, ${discoveryClean}, ${myPageClean}, ${showUnfollowed}}) with tag="未互关提示", requires_body=true, binary_body_mode=true, timeout=10
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/link\/home\/framework\/tab(?:\?|$)/i then script("http://192.168.3.35:18765/NeteaseCloudMusic.js", {${homeClean}, ${MY}, ${DT}, ${FX}, ${PRGG}, ${PRRK}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${PRRR}, ${HMPR}, ${PRMST}, ${PRCN}, ${commentsClean}, ${discoveryClean}, ${myPageClean}, ${showUnfollowed}}) with tag="底栏标签", requires_body=true, binary_body_mode=true, timeout=10

[Mitm]
hostname = interface*.music.163.com
