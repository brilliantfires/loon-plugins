#!name=YouTube
#!loon_version=3.5.1(998)
#!system=iOS,iPadOS,macOS
#!system_version=15
#!desc=依据用户提供的Maasea脚本整理，处理视频、信息流、搜索和Shorts广告。仅去广告。使用本地脚本及initplayback空响应回退，播放兼容性待实机验证。请启用MitM over HTTP/2和QUIC回退保护。
#!author=原规则与脚本：Maasea、VirgilClyne、Choler、DivineEngine、app2smile；本地整理：Codex

[Rule]
AND,((PROTOCOL,QUIC),(DOMAIN,youtubei.googleapis.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,googlevideo.com)),REJECT

[Rewrite]
# 沿用原请求脚本未命中密钥时的本地空响应回退。
response if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|get_watch)(\?(.*))?$/i then script("http://192.168.3.35:18765/YouTube.js") with tag="YouTube广告过滤", requires_body=true, binary_body_mode=true, timeout=10

[Mitm]
hostname = youtubei.googleapis.com, *.googlevideo.com
