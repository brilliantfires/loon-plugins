#!name=微博
#!loon_version=3.5.1(998)
#!desc=基于用户提供的规则和脚本本地维护，过滤广告并按页面精简推广内容，提供12项独立开关，默认全部开启。待实机验证。
#!author=原规则与脚本：RuCu6、zmqcherish；本地整理：Codex

[Argument]
splashAds = switch,true,tag=开屏广告,desc=调整开屏投放与等待配置
feedClean = switch,true,tag=首页与关注流精简,desc=过滤广告及原规则中的关注推荐快转等内容
commentsClean = switch,true,tag=评论区精简,desc=过滤评论推广气泡弹幕及提示
searchClean = switch,true,tag=搜索与发现精简,desc=过滤热搜推广搜索推荐及发现页模块
profileClean = switch,true,tag=个人主页精简,desc=清理博主主页推荐皮肤及关注弹窗
myPageClean = switch,true,tag=我的页面精简,desc=按原规则保留个人页指定入口
messageClean = switch,true,tag=消息页精简,desc=清理活动通知闪聊及动态广告
detailClean = switch,true,tag=微博详情精简,desc=清理商品投票赞赏模块并调整详情菜单
videoClean = switch,true,tag=视频页精简,desc=清理视频广告商品悬浮窗及红包
videoAutoplay = switch,true,tag=关闭视频连播,desc=清空自动连播列表
chaohuaClean = switch,true,tag=超话页精简,desc=清理超话推荐热词及广场入口
homeClean = switch,true,tag=首页推广精简,desc=清理签到红包悬浮窗和发布入口

[Rule]
DOMAIN-SUFFIX,uve.weibo.com,DIRECT
DOMAIN,huodong.weibo.cn,REJECT
DOMAIN-SUFFIX,biz.weibo.com,REJECT

[Rewrite]
request if ${homeClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(?:ug\/checkin\/list|push\/daily|push\/info)/i then reject_dict(200)
request if ${videoClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/live\/media_homelist\?/i then reject_dict(200)
request if ${commentsClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/comments\/bullet_screens\?/i then reject_dict(200)
request if ${detailClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/photo\/info\?/i then reject_dict(200)
request if ${feedClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_positive|push_info)/i then reject_dict(200)
request if ${detailClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/vote\/get_vote_detail\?/i then reject_dict(200)
request if ${chaohuaClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/chaohua\/discovery\/home_bottom\/switch\?/i then reject_dict(200)
request if ${chaohuaClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange)/i then reject_dict(200)
request if ${homeClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/wbox\/\w+\/(?:home_bottom_modal|interest_category)/i then reject_dict(200)
request if ${searchClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_discover|finder_nav_polling)\?/i then reject_dict(200)
request if ${searchClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\?/i then reject_dict(200)
request if ${videoClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/video\/redpacket\?/i then reject_dict(200)
request if ${searchClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/(?:search\/finder_nav_polling|sug\/list\/finderchange|was\/finder\/searchbarchange)\?/i then reject_dict(200)
request if ${videoClean} == true && ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/video\/tiny_video_info_show\?/i then reject_dict(200)
request if ${splashAds} == true && ${url} ~= /^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php)/i then reject_dict(200)
request if ${detailClean} == true && ${url} ~= /^https:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead)/i then reject_dict(200)
request if ${detailClean} == true && ${url} ~= /^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead)/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(?:checkin\/show|client\/publisher_list|push\/active)/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理1"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/groups\/allgroups\/v2\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理2"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(?:cardlist|page)/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理3"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理4"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(?:container\/asyn|flowlist|flowpage)/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理5"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/friendships\/(?:create|destroy)/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理6"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/profile\/(?:container_timeline|dealatt|me|statuses\/tab|userinfo)/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理7"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/shproxy\/chaohua\/discovery\/searchactive\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理8"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:comments_expand_child|container_detail_comment)/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理9"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_detail\?|container_timeline(?:_hot|_topic|_topicpage|_unread)?|repost_timeline|unread_hot_timeline)/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理10"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:extend|show)\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理11"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/video\/(?:full_screen_stream|tiny_stream_mid_detail|tiny_stream_video_list)\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理12"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/huati\/discovery_home_bottom_channels\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理13"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/direct_messages\/user_list\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理14"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/messageflow\/notice\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理15"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_timeline|finder)\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理16"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/searchall\?/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理17"
response if ${url} ~= /^https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理18"
response if ${url} ~= /^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理19"
response if ${url} ~= /^https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua)/i then script("http://192.168.3.35:18765/Weibo.js", {${splashAds}, ${feedClean}, ${commentsClean}, ${searchClean}, ${profileClean}, ${myPageClean}, ${messageClean}, ${detailClean}, ${videoClean}, ${videoAutoplay}, ${chaohuaClean}, ${homeClean}}) with requires_body=true, timeout=10, tag="微博响应处理20"

[Mitm]
hostname = *.weibo.cn, *.weibo.com, weibo.com
