#!name=知乎
#!desc=v3：保留原开屏和回答广告过滤，新增首页/搜索浮层及launch_v2预加载广告过滤；四条原生重写，无远程脚本。

[Rewrite]
# 开屏：保留 launch 字符串类型，清空广告列表。
^https:\/\/api\.zhihu\.com\/commercial_api\/real_time_launch_v2(?:\?|$) response-body-json-jq '.launch|=(fromjson|.ads=[]|tojson)'
# 回答底部广告：匹配任意回答 ID，不依赖品牌或商品链接。
^https:\/\/api\.zhihu\.com\/commercial_api\/answer\/[0-9]+\/bottom-v2(?:\?|$) response-body-json-jq '.adjson|=(fromjson|.ads=[]|tojson)'
# 回答流：仅移除明确标记为 ad 的条目，保留回答及分页信息。
^https:\/\/api\.zhihu\.com\/next-render(?:\?|$) response-body-json-jq '.data|=map(select(.type!="ad"))'

# 浮层及预加载：同时清理两个实际下发入口，保留JSON字符串类型。
^https:\/\/api\.zhihu\.com\/commercial_api\/(?:app_float_layer|launch_v2)(?:\?|$) response-body-json-jq 'reduce ["app_float_video","float_layer","search_middle_page","launch"][] as $k (.; if has($k) then .[$k] |= (if type == "string" then (fromjson | .ads=[] | tojson) elif type == "object" then .ads=[] else . end) else . end)'

[Mitm]
hostname = api.zhihu.com
