#!name=哔哩哔哩
#!loon_version=3.5.1(998)
#!system=iOS,iPadOS
#!system_version=15
#!desc=默认仅过滤广告。页面精简、空降助手、请求重取和播放增强等默认关闭。默认不匹配弹幕和播放进度接口。实际功耗与手机效果待验证。
#!author=原脚本：kokoryh；本地整理：Codex

[Argument]
splashAds = switch,true,tag=开屏广告
feedAds = switch,true,tag=推荐与动态广告
videoAds = switch,true,tag=视频页广告
liveAds = switch,true,tag=直播页广告
commentAds = switch,true,tag=评论广告字段
uiClean = switch,false,tag=页面精简
feedVideoOnly = switch,false,tag=首页只留视频卡片
searchClean = switch,false,tag=搜索提示精简
dynamicCustomize = switch,false,tag=调整最常访问列表
purifyComment = switch,false,tag=过滤推广关键词置顶评论
optimizeRequest = switch,false,tag=请求重取优化
sponsorBlock = switch,false,tag=空降助手
playbackEnhance = switch,false,tag=后台播放与投屏增强
disableTeenMode = switch,false,tag=关闭青少年提示
p2pClean = switch,false,tag=替换P2P调度配置
displayUpList = select,"auto","show","hide",tag=最常访问显示方式,desc=仅在调整最常访问列表开启时生效
logLevel = select,"off","error","warn","info","debug",tag=日志等级

[Rewrite]
response if ${splashAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\?/i then response.json.jq("if (.data | type) == \"object\" then .data |= with_entries(if .key | IN(\"show\", \"event_list\") then .value = [] else . end) else . end")
response if ${splashAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?/i then response.body.mock("json", "{\"code\":0,\"message\":\"OK\",\"ttl\":1,\"data\":{\"max_time\":0,\"min_interval\":31536000,\"pull_interval\":31536000,\"keep_ids\":[],\"show\":[],\"list\":[{}],\"splash_request_id\":\"\"}}", 200)
response if ${feedAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?/i then response.json.jq("if (.data.items | type) == \"array\" then .data.items |= map(select(.ad_info == null)) else . end")
response if ${feedVideoOnly} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?/i then response.json.jq("if (.data.items | type) == \"array\" then .data.items |= map(select(.banner_item == null and .card_goto == \"av\" and (.card_type | IN(\"small_cover_v2\", \"large_cover_single_v9\", \"large_cover_v1\")))) else . end")
response if ${feedAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\?/i then response.json.jq("if (.data.items | type) == \"array\" then .data.items |= map(select(.ad_info == null and (.card_goto | IN(\"vertical_ad_av\", \"vertical_ad_live\", \"vertical_ad_picture\") | not))) else . end")
response if ${uiClean} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\?/i then response.json.jq("if (.data.items | type) == \"array\" then .data.items |= map(del(.story_cart_icon,.free_flow_toast,.image_infos,.course_info,.game_info)) else . end")
response if ${videoAds} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?/i then response.body.mock("json", "{\"code\":0,\"data\":{\"closeType\":\"close_win\",\"container\":[],\"showTime\":\"\"},\"message\":\"success\"}", 200)
response if ${uiClean} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\?/i then response.json.delete("data.payment")
response if ${uiClean} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\?/i then response.json.jq("if (.data.modules | type) == \"array\" then .data.modules |= map(select(.type != \"TIP\") | if .type == \"BANNER\" and (.module_data.items | type) == \"array\" then .module_data.items |= map(select(.url | startswith(\"https://www.bilibili.com/blackboard/era/\") | not)) else . end) else . end")
response if ${uiClean} == true && ${url} ~= /^https:\/\/ap[ip]\.bilibili\.com\/x\/resource\/(top\/activity|patch\/tab(\/v2)?)\?/i then response.body.mock("json", "{\"code\":-404,\"message\":\"-404\",\"ttl\":1,\"data\":null}", 200)
response if ${searchClean} == true && ${url} ~= /^https:\/\/ap[ip]\.bilibili\.com\/x\/v2\/search\/square\?/i then response.body.mock("json", "{\"code\":-404,\"message\":\"-404\",\"ttl\":1,\"data\":null}", 200)
response if ${videoAds} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/vip\/ads\/materials\?/i then response.body.mock("json", "{\"code\":-404,\"message\":\"-404\",\"ttl\":1,\"data\":null}", 200)
request if ${liveAds} == true && ${url} ~= /^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\?/i then reject_dict(200)
request if ${liveAds} == true && ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\?/i then reject_dict(200)
response if ${liveAds} == true && ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/index\/feed\?/i then response.json.jq("if (.data.card_list | type) == \"array\" then .data.card_list |= map(select(.card_type != \"banner_v2\" and .card_type != \"activity_card_v1\")) else . end")
response if ${liveAds} == true && ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoBy(Room|User)\?/i then response.json.delete(["data.shopping_info", "data.activity_banner_info"])
response if ${uiClean} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?/i then response.json.delete("data.common_equip")
response if ${p2pClean} == true && ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\?/i then response.json.jq(".data[][]?=\"stun.chat.bilibili.com:3478\"")
response if ${p2pClean} == true && ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\?/i then response.json.jq(".data.domains=[\"wss://tracker.chat.bilibili.com\"]")
response if ${disableTeenMode} == true && ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$/i then response.body.mock("text", "AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA", 200, true) | response.header.add("grpc-status", "0")
response if ${searchClean} == true && ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$/i then response.body.mock("text", "AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=", 200, true) | response.header.add("grpc-status", "0")
response if ${uiClean} == true && ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$/i then response.body.mock("text", "AAAAAAA=", 200, true) | response.header.add("grpc-status", "0")

[Script]
response if ${feedAds} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll)$/i then script("http://192.168.3.35:18765/Bilibili.proto.js", {${splashAds}, ${feedAds}, ${videoAds}, ${liveAds}, ${commentAds}, ${uiClean}, ${feedVideoOnly}, ${searchClean}, ${dynamicCustomize}, ${purifyComment}, ${optimizeRequest}, ${sponsorBlock}, ${playbackEnhance}, ${disableTeenMode}, ${p2pClean}, ${displayUpList}, ${logLevel}}) with tag="推荐动态广告", requires_body=true, binary_body_mode=true, timeout=10
response if ${videoAds} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.view(unite)?\.v1\.View\/(View|RelatesFeed|AIRelateAsync)$/i then script("http://192.168.3.35:18765/Bilibili.proto.js", {${splashAds}, ${feedAds}, ${videoAds}, ${liveAds}, ${commentAds}, ${uiClean}, ${feedVideoOnly}, ${searchClean}, ${dynamicCustomize}, ${purifyComment}, ${optimizeRequest}, ${sponsorBlock}, ${playbackEnhance}, ${disableTeenMode}, ${p2pClean}, ${displayUpList}, ${logLevel}}) with tag="视频页广告", requires_body=true, binary_body_mode=true, timeout=10
response if ${feedAds} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$/i then script("http://192.168.3.35:18765/Bilibili.proto.js", {${splashAds}, ${feedAds}, ${videoAds}, ${liveAds}, ${commentAds}, ${uiClean}, ${feedVideoOnly}, ${searchClean}, ${dynamicCustomize}, ${purifyComment}, ${optimizeRequest}, ${sponsorBlock}, ${playbackEnhance}, ${disableTeenMode}, ${p2pClean}, ${displayUpList}, ${logLevel}}) with tag="搜索广告", requires_body=true, binary_body_mode=true, timeout=10
response if ${commentAds} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList$/i then script("http://192.168.3.35:18765/Bilibili.proto.js", {${splashAds}, ${feedAds}, ${videoAds}, ${liveAds}, ${commentAds}, ${uiClean}, ${feedVideoOnly}, ${searchClean}, ${dynamicCustomize}, ${purifyComment}, ${optimizeRequest}, ${sponsorBlock}, ${playbackEnhance}, ${disableTeenMode}, ${p2pClean}, ${displayUpList}, ${logLevel}}) with tag="评论广告", requires_body=true, binary_body_mode=true, timeout=10
response if ${sponsorBlock} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.view(unite)?\.v1\.View\/ViewProgress$/i then script("http://192.168.3.35:18765/Bilibili.proto.js", {${splashAds}, ${feedAds}, ${videoAds}, ${liveAds}, ${commentAds}, ${uiClean}, ${feedVideoOnly}, ${searchClean}, ${dynamicCustomize}, ${purifyComment}, ${optimizeRequest}, ${sponsorBlock}, ${playbackEnhance}, ${disableTeenMode}, ${p2pClean}, ${displayUpList}, ${logLevel}}) with tag="空降助手配置", requires_body=true, binary_body_mode=true, timeout=10
response if ${playbackEnhance} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(app\.(playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$/i then script("http://192.168.3.35:18765/Bilibili.proto.js", {${splashAds}, ${feedAds}, ${videoAds}, ${liveAds}, ${commentAds}, ${uiClean}, ${feedVideoOnly}, ${searchClean}, ${dynamicCustomize}, ${purifyComment}, ${optimizeRequest}, ${sponsorBlock}, ${playbackEnhance}, ${disableTeenMode}, ${p2pClean}, ${displayUpList}, ${logLevel}}) with tag="播放增强", requires_body=true, binary_body_mode=true, timeout=10
request if ${sponsorBlock} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$/i then script("http://192.168.3.35:18765/Bilibili.request.js", {${splashAds}, ${feedAds}, ${videoAds}, ${liveAds}, ${commentAds}, ${uiClean}, ${feedVideoOnly}, ${searchClean}, ${dynamicCustomize}, ${purifyComment}, ${optimizeRequest}, ${sponsorBlock}, ${playbackEnhance}, ${disableTeenMode}, ${p2pClean}, ${displayUpList}, ${logLevel}}) with tag="空降助手", requires_body=true, binary_body_mode=true, timeout=10
request if ${optimizeRequest} == true && ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$/i then script("http://192.168.3.35:18765/Bilibili.request.js", {${splashAds}, ${feedAds}, ${videoAds}, ${liveAds}, ${commentAds}, ${uiClean}, ${feedVideoOnly}, ${searchClean}, ${dynamicCustomize}, ${purifyComment}, ${optimizeRequest}, ${sponsorBlock}, ${playbackEnhance}, ${disableTeenMode}, ${p2pClean}, ${displayUpList}, ${logLevel}}) with tag="请求重取", requires_body=true, binary_body_mode=true, timeout=10
response if ${uiClean} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/(resource\/show\/tab\/v2|v2\/account\/mine(\/ipad)?)\?/i then script("http://192.168.3.35:18765/Bilibili.layout.js", {${logLevel}}) with tag="页面精简", requires_body=true, timeout=10

[Mitm]
hostname = grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, line3-h5-mobile-api.biligame.com
