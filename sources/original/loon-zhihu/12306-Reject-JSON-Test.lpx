#!name=12306
#!desc=开屏广告与5项应用内推广请求直接返回空JSON，无外部脚本依赖。应用内过滤由原先断开连接改为HTTP 200空JSON，待实机复测。需要支持请求头条件的新式复写语法。

[Rewrite]
# 开屏广告
request if ${url} ~= /^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList(?:\?|$)/i then reject_dict(200)
# 应用内推广：同时限定接口路径与operation-type完整值
request if ${url} ~= /^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\// && ${request.header['operation-type']} ~= /^com\.cars\.otsmobile\.(?:integration\.activityBanner|memberInfo\.getMemberQa|newHomePage\.initData|newHomePageBussData|paySuccBuss\.bussEntryShow)$/ then reject_dict(200)

[Mitm]
hostname = ad.12306.cn, mobile.12306.cn
